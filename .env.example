KYQRA_IMAGE=ghcr.io/ingtrader21-spec/kyqra-crawler-production@sha256:replace-with-64-lowercase-hex-characters
KYQRA_ENV_FILE=.env
KYQRA_SECRETS_GID=replace-with-the-host-kyqra-secrets-group-id
KYQRA_SERVICE_PRINCIPALS_FILE=/etc/kyqra/secrets/service-principals.json
KYQRA_REDIS_PASSWORD_FILE=/etc/kyqra/secrets/redis-password
KYQRA_POSTGRES_PASSWORD_FILE=/etc/kyqra/secrets/postgres-password
KYQRA_MIDDLEWARE_API_KEY_FILE=/etc/kyqra/secrets/middleware-api-key
KYQRA_WEBHOOK_SECRET_FILE=/etc/kyqra/secrets/webhook-hmac-secret
MIDDLEWARE_BASE_URL=https://middleware.internal.codestra.agency
CALLBACK_ALLOWLIST=kyqra.com,middleware.internal.codestra.agency
CRAWL_HOST_DENYLIST=
CRAWL_HOST_ALLOWLIST=
KYQRA_JOBS_PER_MINUTE=30
# Deep readiness probes are served only here; never publish this port.
INTERNAL_HEALTH_HOST=127.0.0.1
INTERNAL_HEALTH_PORT=3001
ROBOTS_USER_AGENT=KyqraCrawler
ROBOTS_CACHE_TTL_SECONDS=3600
ROBOTS_MAX_CRAWL_DELAY_SECONDS=30
# Frontier claims: how long a claim survives without progress, and how often a worker
# returns claims abandoned by a replica that was killed rather than shut down.
FRONTIER_VISIBILITY_SECONDS=120
FRONTIER_SWEEP_SECONDS=30
# Upper bound on the graceful stop; keep below the compose stop_grace_period.
SHUTDOWN_GRACE_SECONDS=25
# Identity recorded on frontier claims. Defaults to hostname:pid.
KYQRA_WORKER_ID=
HTTP_CONCURRENCY=15
BROWSER_CONCURRENCY=3
JOB_CONCURRENCY=2
